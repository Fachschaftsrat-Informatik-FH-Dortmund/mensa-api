                }
              }
            }
          }
        },
        "description": "Statusprüfung für Monitoring.\n\nGibt einen Status-Wert und einen aktuellen Zeitstempel zurück. Geeignet zur\nEinbindung in Uptime-/Monitoring-Systeme.",
        "tags": ["System"]
      }
    }
  },
  "components": {
    "schemas": {
      "ClosureSchema": {
        "description": "Ein Schließtag oder Schließzeitraum.\n\nEntweder `date` ist gesetzt (Einzeltag) ODER `date_from`/`date_to`\n(Zeitraum, jeweils inklusiv). Die jeweils anderen Felder sind dann null.",
        "properties": {
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Bezeichnung, z. B. 'Weihnachtsferien' oder 'Renovierung'.",
            "example": "Weihnachtsferien",
            "title": "Label"
          },
          "date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Einzelner Schließtag (ISO 8601), oder null bei Zeitraum.",
            "example": "2026-12-24",
            "title": "Date"
          },
          "date_from": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Beginn des Schließzeitraums (inklusiv), oder null bei Einzeltag.",
            "title": "Date From"
          },
          "date_to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Ende des Schließzeitraums (inklusiv), oder null bei Einzeltag.",
            "title": "Date To"
          }
        },
        "title": "ClosureSchema",
        "type": "object"
      },
      "ClosuresSchema": {
        "description": "Bevorstehende Schließungen im Vorschaufenster.",
        "properties": {
          "window_days": {
            "default": 30,
            "description": "Größe des Vorschaufensters in Tagen ab heute.",
            "example": 30,
            "title": "Window Days",
            "type": "integer"
          },
          "global": {
            "description": "Für alle Restaurants geltende Schließtage, inklusive automatisch importierter NRW-Feiertage (erkennbar am Flag is_holiday).",
            "items": {
              "$ref": "#/components/schemas/GlobalClosureSchema"
            },
            "title": "Global",
            "type": "array"
          },
          "restaurant": {
            "description": "Nur für dieses Restaurant geltende Schließtage.",
            "items": {
              "$ref": "#/components/schemas/ClosureSchema"
            },
            "title": "Restaurant",
            "type": "array"
          }
        },
        "title": "ClosuresSchema",
        "type": "object"
      },
      "DayScheduleSchema": {
        "description": "Regulärer Plan für einen Wochentag – ohne Kalenderbezug.\n\nAchtung: `is_open` beschreibt hier den REGULÄREN Wochenplan. Feiertage und\nSchließtage sind hier NICHT berücksichtigt – dafür `forecast` bzw.\n`closures` verwenden.",
        "properties": {
          "is_open": {
            "description": "Ob an diesem Wochentag regulär geöffnet ist. Ohne Berücksichtigung von Feiertagen und Schließtagen.",
            "title": "Is Open",
            "type": "boolean"
          },
          "regular_hours": {
            "$ref": "#/components/schemas/HoursSchema"
          },
          "serving_hours": {
            "$ref": "#/components/schemas/HoursSchema",
            "description": "Ausgabezeiten für warme Speisen. Sind keine eigenen Zeiten gepflegt, entsprechen sie den regulären Öffnungszeiten."
          },
          "serving_hours_differ": {
            "default": false,
            "description": "true, wenn eigene Ausgabezeiten gepflegt sind und diese von den Öffnungszeiten abweichen. false, wenn serving_hours nur eine Kopie von regular_hours ist.",
            "title": "Serving Hours Differ",
            "type": "boolean"
          }
        },
        "required": ["is_open", "regular_hours", "serving_hours"],
        "title": "DayScheduleSchema",
        "type": "object"
      },
      "ForecastDaySchema": {
        "description": "Ein konkreter Kalendertag der 7-Tage-Vorschau.",
        "properties": {
          "date": {
            "description": "Datum des Tages (ISO 8601, YYYY-MM-DD).",
            "example": "2026-07-25",
            "title": "Date",
            "type": "string"
          },
          "weekday": {
            "description": "Wochentag in Kleinbuchstaben (monday bis sunday).",
            "example": "saturday",
            "title": "Weekday",
            "type": "string"
          },
          "is_open": {
            "description": "Ob an diesem Tag geöffnet ist. Kombiniert den regulären Wochenplan mit Feiertagen und Schließtagen.",
            "title": "Is Open",
            "type": "boolean"
          },
          "closed_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Grund der Schließung, falls der Tag durch einen Schließtag abgedeckt ist. null, wenn kein Schließtag greift. Achtung: An regulär geschlossenen Tagen (z. B. Wochenende) ist is_open false und closed_reason trotzdem null.",
            "example": "Globaler Schließtag: Tag der Deutschen Einheit",
            "title": "Closed Reason"
          },
          "regular_hours": {
            "$ref": "#/components/schemas/HoursSchema"
          },
          "serving_hours": {
            "$ref": "#/components/schemas/HoursSchema",
            "description": "Ausgabezeiten für warme Speisen an diesem Tag. Sind keine eigenen Zeiten gepflegt, entsprechen sie den regulären Öffnungszeiten."
          },
          "serving_hours_differ": {
            "default": false,
            "description": "true, wenn eigene Ausgabezeiten gepflegt sind und diese von den Öffnungszeiten abweichen. false, wenn serving_hours nur eine Kopie von regular_hours ist.",
            "title": "Serving Hours Differ",
            "type": "boolean"
          }
        },
        "required": [
          "date",
          "weekday",
          "is_open",
          "regular_hours",
          "serving_hours"
        ],
        "title": "ForecastDaySchema",
        "type": "object"
      },
      "GlobalClosureSchema": {
        "description": "Globaler Schließtag – betrifft alle Restaurants.",
        "properties": {
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Bezeichnung, z. B. 'Weihnachtsferien' oder 'Renovierung'.",
            "example": "Weihnachtsferien",
            "title": "Label"
          },
          "date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Einzelner Schließtag (ISO 8601), oder null bei Zeitraum.",
            "example": "2026-12-24",
            "title": "Date"
          },
          "date_from": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Beginn des Schließzeitraums (inklusiv), oder null bei Einzeltag.",
            "title": "Date From"
          },
          "date_to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Ende des Schließzeitraums (inklusiv), oder null bei Einzeltag.",
            "title": "Date To"
          },
          "is_holiday": {
            "default": false,
            "description": "true, wenn der Eintrag automatisch aus den NRW-Feiertagen erzeugt wurde. false bei manuell gepflegten Einträgen.",
            "title": "Is Holiday",
            "type": "boolean"
          }
        },
        "title": "GlobalClosureSchema",
        "type": "object"
      },
      "HoursSchema": {
        "description": "Öffnungs- und Schließzeit eines Tages.\n\nBeide Werte sind `null`, wenn für den Tag keine Zeiten hinterlegt sind\n(z. B. Wochenende bei reinen Werktags-Mensen).",
        "properties": {
          "open": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
