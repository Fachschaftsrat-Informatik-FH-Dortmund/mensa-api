          },
          "weekend": {
            "$ref": "#/components/schemas/WeekendSchema"
          }
        },
        "required": [
          "restaurant_id",
          "today",
          "closures",
          "weekdays",
          "weekend"
        ],
        "title": "NormalizedOpeningTimesSchema",
        "type": "object"
      },
      "TodayStatusSchema": {
