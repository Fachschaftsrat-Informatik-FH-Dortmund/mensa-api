            "in": "query",
            "name": "verbrauchsortnr",
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Nur Artikel eines bestimmten Ortes. IDs siehe GET /verbrauchsorte.",
              "title": "Verbrauchsortnr"
            },
            "required": false,
            "description": "Nur Artikel eines bestimmten Ortes. IDs siehe GET /verbrauchsorte."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MenuItemRawSchema"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            }
          }
        },
        "description": "Speiseplan-Artikel für den heutigen Tag abrufen.\n\nLiefert die Artikel des aktuellen Tages, optional auf einen bestimmten Ort\n(Mensa/Cafeteria) über `verbrauchsortnr` eingegrenzt.\n\nRückgabe:\n    Liste von Menü-Artikeln (siehe MenuItemRawSchema).",
        "tags": ["Speiseplan"]
      }
    },
    "/api/v2/speiseplan/naechste-2-wochen": {
      "get": {
        "operationId": "odyssee_api_hole_speiseplan_naechste_2_wochen",
        "summary": "Hole Speiseplan Naechste 2 Wochen",
        "parameters": [
          {
            "in": "query",
            "name": "verbrauchsortnr",
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Nur Artikel eines bestimmten Ortes. IDs siehe GET /verbrauchsorte.",
              "title": "Verbrauchsortnr"
            },
            "required": false,
            "description": "Nur Artikel eines bestimmten Ortes. IDs siehe GET /verbrauchsorte."
          },
          {
            "in": "query",
